{
  "name": "vyapar-app",
  "version": "1.0.0",
  "description": "Viper - Customer Invoicing, Inventory and Accounting",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "client:build": "vite build",
    "client:preview": "vite preview",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "build": "npm run client:build && npm run server:build",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "android:sync": "npm run client:build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat :app:assembleDebug",
    "verify": "npm run type-check && npm test && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
